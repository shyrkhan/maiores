#!/usr/bin/env python3
"""An MCP server (stdio, JSON-RPC 2.0, one message per line) over the developer-mode
remote control (devtools/devmode.py, devtools/drive.py). Standard library only.

    claude mcp add --scope user maiores -- python3 /path/to/maiores/tools/maiores-mcp

maiores_launch starts a hidden copy: offscreen, CPU-capped, with its own home
folder (so it never sees the real trees or settings) and no map pictures from the internet, opening the made-up family
or a tree you name. Every other tool takes "instance": "hidden" (the default
while one runs) or "live" (a copy someone started with `python app.py --dev`).
"""
import getpass
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PYTHON = ROOT / ".venv" / "bin" / "python"
STATE = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "maiores-mcp"
HOME = STATE / "home"
PID_FILE = STATE / "hidden.pid"
LOG_FILE = STATE / "hidden.log"
HIDDEN_SOCKET = str(STATE / "hidden.sock")
LIVE_SOCKET = os.path.join(tempfile.gettempdir(), f"maiores-dev-{getpass.getuser()}")
CAP = ["systemd-run", "--user", "--scope", "-q", "-p", "CPUQuota=640%", "-p", "MemoryMax=3G", "nice", "-n", "19"]


# Talking to a running copy.
def hidden_pid():
    try:
        pid = int(PID_FILE.read_text())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def socket_for(instance):
    if instance in (None, "", "hidden"):
        if hidden_pid() and os.path.exists(HIDDEN_SOCKET):
            return HIDDEN_SOCKET
        if instance == "hidden":
            raise RuntimeError("no hidden Maiores runs; call maiores_launch first")
        if os.path.exists(LIVE_SOCKET):
            return LIVE_SOCKET
        raise RuntimeError("no Maiores is reachable: call maiores_launch, or start one with `python app.py --dev`")
    if instance == "live":
        return LIVE_SOCKET
    raise RuntimeError("instance is hidden or live")


def call(instance, command, arg=None, timeout=60):
    path = socket_for(instance)
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(timeout)
        try:
            s.connect(path)
        except OSError as e:
            raise RuntimeError(f"cannot reach Maiores at {path}: {e}") from None
        s.sendall(json.dumps({"cmd": command, "arg": arg}, ensure_ascii=False).encode() + b"\n")
        data = b""
        while not data.endswith(b"\n"):
            chunk = s.recv(1 << 20)
            if not chunk:
                break
            data += chunk
    reply = json.loads(data)
    if not reply.get("ok"):
        raise RuntimeError(reply.get("error"))
    return reply["result"]


# Starting and stopping the hidden copy.
def prepare_home(fresh):
    if fresh and HOME.exists():
        shutil.rmtree(HOME)
    config = HOME / ".config" / "Maiores"
    config.mkdir(parents=True, exist_ok=True)
    conf = config / "Maiores.conf"
    if not conf.exists():
        # No first-run tour over the picture, and no tree reopened from an earlier run.
        conf.write_text("[General]\nfirst_tour=done\nreopen_last_tree=false\nmap_tiles_allowed=no\n")
    (HOME / "Documents").mkdir(exist_ok=True)


def launch(args):
    if hidden_pid():
        stop()
    STATE.mkdir(parents=True, exist_ok=True)
    prepare_home(bool(args.get("fresh")))
    tree = args.get("tree")
    command = [str(PYTHON), str(ROOT / "app.py"), "--dev"]
    if not tree and args.get("editable"):
        # A copy of the made-up family as a real tree in the hidden home, so edits can be tried and saved.
        tree = HOME / "Documents" / "Maiores" / "Made-up family"
        if not tree.exists():
            env = dict(os.environ, QT_QPA_PLATFORM="offscreen", HOME=str(HOME))
            subprocess.run([str(PYTHON), "-c", "import sys; from pathlib import Path; from storage import create_tree; "
                            "from sample import sample_tree; create_tree(Path(sys.argv[1]), sample_tree())", str(tree)],
                           cwd=ROOT, env=env, check=True, capture_output=True)
    if tree:
        command.append(str(Path(tree).expanduser()))
    elif args.get("sample", True):
        command.append("--sample")
    if args.get("language"):
        command += ["--language", args["language"]]
    if args.get("theme"):
        command += ["--theme", args["theme"]]
    env = dict(os.environ, HOME=str(HOME), XDG_CONFIG_HOME=str(HOME / ".config"),
               XDG_DATA_HOME=str(HOME / ".local" / "share"), XDG_CACHE_HOME=str(HOME / ".cache"),
               QT_QPA_PLATFORM="offscreen", FT_STILL="1", MAIORES_DEV_SOCKET=HIDDEN_SOCKET)
    env.pop("XDG_DOCUMENTS_DIR", None)
    # Links and files it opens (Report a problem, an exported report) must not reach the real desktop:
    # a stand-in xdg-open only writes them to the log, and the app gets no display or session bus.
    # systemd-run still needs the bus itself, so it is taken away just around the program.
    fake = HOME / "bin"
    fake.mkdir(exist_ok=True)
    (fake / "xdg-open").write_text('#!/bin/sh\necho "[would open] $*"\n')
    (fake / "xdg-open").chmod(0o755)
    command = ["env", "-u", "DBUS_SESSION_BUS_ADDRESS", "-u", "DISPLAY", "-u", "WAYLAND_DISPLAY",
               f"PATH={fake}:{env.get('PATH', '/usr/bin:/bin')}"] + command
    if os.path.exists(HIDDEN_SOCKET):
        os.unlink(HIDDEN_SOCKET)
    log = open(LOG_FILE, "w")
    capped = CAP if shutil.which("systemd-run") else ["nice", "-n", "19"]
    process = subprocess.Popen(capped + command, cwd=ROOT, env=env, stdin=subprocess.DEVNULL,
                               stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    PID_FILE.write_text(str(process.pid))
    deadline = time.time() + 40
    while time.time() < deadline:
        if process.poll() is not None:
            raise RuntimeError("Maiores stopped while starting:\n" + LOG_FILE.read_text()[-3000:])
        if os.path.exists(HIDDEN_SOCKET):
            try:
                state = call("hidden", "state")
                size = args.get("size")
                if size:
                    call("hidden", "resize", size)
                return f"hidden Maiores running (pid {process.pid}), home {HOME}\n" + json.dumps(state, ensure_ascii=False, indent=1)
            except RuntimeError:
                pass
        time.sleep(0.3)
    raise RuntimeError("Maiores did not answer within 40 s; log:\n" + LOG_FILE.read_text()[-3000:])


def stop():
    pid = hidden_pid()
    if not pid:
        return "no hidden Maiores was running"
    try:
        os.killpg(pid, signal.SIGTERM)
    except OSError:
        os.kill(pid, signal.SIGTERM)
    for _ in range(30):
        if not hidden_pid():
            break
        time.sleep(0.1)
    else:
        try:
            os.killpg(pid, signal.SIGKILL)
        except OSError:
            pass
    PID_FILE.unlink(missing_ok=True)
    if os.path.exists(HIDDEN_SOCKET):
        os.unlink(HIDDEN_SOCKET)
    return f"stopped the hidden Maiores (pid {pid})"


def status():
    out = {"hidden": None, "live": None}
    if hidden_pid():
        out["hidden"] = {"pid": hidden_pid(), "home": str(HOME), "log": str(LOG_FILE)}
    if os.path.exists(LIVE_SOCKET):
        try:
            call("live", "state", timeout=3)
            out["live"] = "reachable (python app.py --dev)"
        except RuntimeError as e:
            out["live"] = f"socket there but not answering: {e}"
    return out


def run_checks(args):
    kind = args.get("kind", "quick")
    flags = {"quick": ["--quick"], "full": [], "seeds": ["--seeds"], "steps": ["--steps"], "perf": ["--perf"],
             "fuzz": ["--fuzz"], "leaks": ["--leaks"], "sweep": ["--sweep"]}.get(kind)
    if flags is None:
        raise RuntimeError("kind is quick, full, seeds, steps, perf, fuzz, leaks or sweep")
    capped = CAP if shutil.which("systemd-run") else ["nice", "-n", "19"]
    env = dict(os.environ, QT_QPA_PLATFORM="offscreen", FT_STILL="1")
    done = subprocess.run(capped + [str(PYTHON), "tools/check.py", *flags], cwd=ROOT, env=env,
                          capture_output=True, text=True, timeout=int(args.get("timeout") or 1800))
    out = (done.stdout + done.stderr).strip()
    return f"exit {done.returncode}\n" + (out[-6000:] if len(out) > 6000 else out)


