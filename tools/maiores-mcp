def text(value):
    return {"content": [{"type": "text", "text": value if isinstance(value, str)
                         else json.dumps(value, ensure_ascii=False, indent=1)}]}


def picture(result):
    return {"content": [{"type": "image", "data": result["png"], "mimeType": "image/png"},
                        {"type": "text", "text": f"{result['of']} {result['width']}×{result['height']}"}]}


def run(name, args):
    args = dict(args)
    where = args.pop("instance", None)
    if name == "maiores_launch":
        return text(launch(args))
    if name == "maiores_stop":
        return text(stop())
    if name == "maiores_status":
        return text(status())
    if name == "maiores_test":
        return text(run_checks(args))
    if name == "maiores_wait":
        time.sleep(min(int(args.get("ms") or 500), 30000) / 1000)
        return text("waited")
    if name == "maiores_screenshot":
        return picture(call(where, "picture", {"target": args.get("target", "")}))
    if name == "maiores_log":
        lines = int(args.get("lines") or 40)
        out = "\n".join(call(where, "log", str(lines)))
        if (where in (None, "", "hidden")) and hidden_pid() and LOG_FILE.exists():
            noise = ("This plugin does not support",)  # The offscreen platform's harmless notes.
            tail = [l for l in LOG_FILE.read_text(errors="replace").splitlines() if not l.startswith(noise)][-lines:]
            out += "\n--- program output ---\n" + "\n".join(tail)
        return text(out)
    if name == "maiores_people":
        rows = call(where, "people")
        return text("\n".join(f"{'* ' if r['selected'] else '  '}{r['id']}: {r['name']} at {r['x']},{r['y']}" for r in rows)
                    or "nobody on screen")
    simple = {"maiores_state": ("state", None), "maiores_checks": ("checks", None), "maiores_fit": ("fit", None),
              "maiores_sample": ("sample", {}),
              "maiores_windows": ("windows", {})}
    if name in simple:
        return text(call(where, *simple[name]))
    if name == "maiores_select":
        return text(call(where, "select", args["who"]))
    if name == "maiores_history":
        return text(call(where, args["do"]))
    if name == "maiores_overlay":
        return text(call(where, "overlay", "on" if args.get("on", True) else "off"))
    mapped = {"maiores_widgets": "widgets", "maiores_describe": "describe", "maiores_click": "click",
              "maiores_key": "key", "maiores_type": "type", "maiores_set": "set", "maiores_menu": "menu",
              "maiores_close": "close", "maiores_person": "person", "maiores_click_person": "click_person",
              "maiores_action": "action", "maiores_open": "open"}
    if name in mapped:
        if name == "maiores_open":
            args["path"] = str(Path(args["path"]).expanduser())
        return text(call(where, mapped[name], args))
    raise RuntimeError(f"unknown tool {name}")


INSTRUCTIONS = ("Drive and inspect Maiores (the family-tree program) through its developer-mode remote control. "
                "Start a hidden copy with maiores_launch (own home folder, made-up family by default), or use "
                "instance=live for one started with `python app.py --dev`. Clicks, keys, menus and actions are "
                "delivered after the reply: call maiores_wait (300-800 ms) before looking again. "
                "Call maiores_stop when done.")


def reply(message_id, result=None, error=None):
    out = {"jsonrpc": "2.0", "id": message_id}
    if error is not None:
        out["error"] = error
    else:
        out["result"] = result
    sys.stdout.write(json.dumps(out, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except ValueError:
            reply(None, error={"code": -32700, "message": "parse error"})
            continue
        method, mid = message.get("method"), message.get("id")
        if mid is None:
            continue
        params = message.get("params") or {}
        if method == "initialize":
            reply(mid, {"protocolVersion": params.get("protocolVersion", "2025-06-18"), "capabilities": {"tools": {}},
                        "serverInfo": {"name": "maiores", "version": "0.1"}, "instructions": INSTRUCTIONS})
        elif method == "ping":
            reply(mid, {})
        elif method == "tools/list":
            reply(mid, {"tools": TOOLS})
        elif method == "tools/call":
            try:
                reply(mid, run(params.get("name"), params.get("arguments") or {}))
            except Exception as e:  # A tool's failure is its answer, not a protocol error.
                reply(mid, {"content": [{"type": "text", "text": f"error: {e}"}], "isError": True})
        else:
            reply(mid, error={"code": -32601, "message": f"no method {method}"})


if __name__ == "__main__":
    main()
